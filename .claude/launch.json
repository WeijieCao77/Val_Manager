{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "val-manager",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "val-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 8080
    },
    {
      "name": "val-server-admin",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANALYTICS_TOKEN=devtoken",
        "DATABASE_URL=pglite://",
        "TRADE_DAYS=0",
        "PORT=8080",
        "node",
        "server.js"
      ],
      "port": 8080
    },
    {
      "name": "val-server-admin-8090",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANALYTICS_TOKEN=devtoken",
        "DATABASE_URL=pglite://",
        "TRADE_DAYS=0",
        "PORT=8090",
        "node",
        "server.js"
      ],
      "port": 8090
    }
  ]
}
