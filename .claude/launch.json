{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "val-manager",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "val-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 8080
    },
    {
      "name": "val-server-admin",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANALYTICS_TOKEN=devtoken",
        "DATABASE_URL=pglite://",
        "TRADE_DAYS=0",
        "PORT=8080",
        "node",
        "server.js"
      ],
      "port": 8080
    },
    {
      "name": "val-server-admin-8090",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANALYTICS_TOKEN=devtoken",
        "DATABASE_URL=pglite://",
        "TRADE_DAYS=0",
        "PORT=8090",
        "node",
        "server.js"
      ],
      "port": 8090
    },
    {
      "name": "val-server-admin-8095",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANALYTICS_TOKEN=devtoken",
        "DATABASE_URL=pglite://",
        "TRADE_DAYS=0",
        "PORT=8095",
        "node",
        "server.js"
      ],
      "port": 8095
    },
    {
      "name": "val-server-cup",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANALYTICS_TOKEN=devtoken",
        "DATABASE_URL=pglite://",
        "TRADE_DAYS=0",
        "PHONE_GATE=0",
        "OPEN_CUP_EVERY_SEC=180",
        "OPEN_CUP_STEP_SEC=20",
        "PORT=8097",
        "node",
        "server.js"
      ],
      "port": 8097
    },
    {
      "name": "val-server-with-player",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANALYTICS_TOKEN=devtoken",
        "DATABASE_URL=pglite://",
        "PLAYER_UPSTREAM=http://127.0.0.1:3100",
        "PORT=8091",
        "node",
        "server.js"
      ],
      "port": 8091
    },
    {
      "name": "val-server-teamcup",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ANALYTICS_TOKEN=devtoken",
        "DATABASE_URL=pglite://",
        "PHONE_GATE=0",
        "TRADE_DAYS=0",
        "TEAM_CUP_EVERY_SEC=150",
        "TEAM_CUP_STEP_SEC=10",
        "PORT=8098",
        "node",
        "server.js"
      ],
      "port": 8098
    }
  ]
}
