    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
